{
    "editor.fontSize": 16,
    // Prevent terminal auto-spawning on startup to fix environment sync race conditions.
    // NOTE: For Claude Code for VS Code, wait until its icon appears on the left sidebar before creating a new terminal.
    // This guarantees extensions load completely first, eliminating stale "environment changed" warnings.
    "terminal.integrated.enablePersistentSessions": false,
    "terminal.integrated.persistentSessionReviveProcess": "never",
    "terminal.integrated.hideOnStartup": "always",
    // Disable inlay hints globally to reduce visual clutter, especially in code-dense files.
    "editor.inlayHints.enabled": "off",
    "files.exclude": {
        "**/.cache": true,
        "**/.git": true,
        "**/node_modules": true,
        "**/bazel-*/": true,
        "**/tools/": true,
        "**/.clang-format": true,
        "**/.clang-tidy": true,
        "**/.editorconfig": true,
        "**/.gitattributes": true,
        "**/.gitignore": true,
        "**/.pre-commit-config.yaml": true,
        "**/compile_commands.json": true,
        "**/commitlint.config.js": true,
        "**/MODULE.bazel.lock": true,
        "**/package-lock.json": true,
        "**/package.json": true,
        "**/external/": true
    }
}